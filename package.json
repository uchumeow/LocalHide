        "@swc/helpers": "^0.5.15",
        "@types/react": "^19.2.0",
        "esbuild": "^0.27.2",
        "rollup": "^4.57.1",
        "rollup-plugin-esbuild": "^6.2.1",
        "typescript": "^5.9.3",
